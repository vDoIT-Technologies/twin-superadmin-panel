{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "experimentalDecorators": false,
    "allowImportingTsExtensions": true
  },
   "include": ["src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "dist", "**/*.ts", "**/*.tsx"]
}
